# Binary media (photos, schematics)
image/

# PlatformIO build artifacts
.pio/
.pioenvs/
.piolibdeps/

# IDE and Editor configurations
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# Compiled binaries and object files
*.bin
*.elf
*.hex
*.o
*.d
*.a
*.so
*.dylib
# Native test executables are created beside their source by some local
# commands; keep source files while ignoring extensionless build outputs.
tools/test_*
!tools/test_*.cpp
!tools/test_*.py

# Temporary benchmark outputs and logs
bench_params.json
*.log
audit/*.jsonl
tools/rc_calibration.json

# Developer context notes
context.md
audit.md

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Agent knowledge graph cache
graphify-out/

# Operating System files
.DS_Store
Thumbs.db
*~
